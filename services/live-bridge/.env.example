# Printer bridge: starts in dry-run; no packets are sent to a printer.
BRIDGE_PORT=47831
BRIDGE_ALLOWED_ORIGINS=http://localhost:2000,http://127.0.0.1:2000
# Blank creates a random pairing token printed once at startup. Keep it local.
BRIDGE_PAIR_TOKEN=
PRINTER_DRY_RUN=true
PRINTER_LAN_IP=
PRINTER_LAN_PORT=9100
# Default Windows browser is installed Microsoft Edge. Optional exact executable.
BRIDGE_BROWSER_EXECUTABLE=

# Updated 2026-09-23. Listener is independent from printer server.
# Normal TikTok-ID flow: npm run worker:channels:login (requires migrations 009/010).
# Set SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY and LIVE_WORKSPACE_ID once below.
# Login prompts for ERP owner/manager email/password, NOT TikTok OAuth/password.
# No LIVE_SESSION_ID needed: a verified LIVE room selects the session on server.
# Install adapter: npm ci --ignore-scripts --include=optional
# Optional channel/session supervisor polling: 1000..30000 ms; default 3000.
# LIVE_SUPERVISOR_POLL_MS=3000
# Advanced manual/simulator only; channel listener always uses TikTok.
LIVE_SOURCE=ndjson
LIVE_FIXTURE_FILE=./fixtures/comments.ndjson
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Leave these blank for any *:login command. Tokens then stay in process memory.
# Automated launch only: provide normal operator tokens via protected environment.
LIVE_OPERATOR_ACCESS_TOKEN=
LIVE_OPERATOR_REFRESH_TOKEN=
LIVE_WORKSPACE_ID=
# Advanced manual/simulator/session supervisor only. Leave blank for channels.
LIVE_SESSION_ID=
# Optional unofficial provider signing service key: server only, never VITE_*.
TIKTOK_SIGN_API_KEY=
