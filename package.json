{
  "name": "chidi-erp",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "ChiDi ERP — React JavaScript and Supabase",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-database.mjs",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run test:db && npm run test:operations && npm run test:foundation && npm run test:live && npm run build",
    "test:catalog": "node scripts/test-catalog-database.mjs",
    "test:customers": "node scripts/test-customer-foundation.mjs",
    "test:inventory": "node scripts/test-inventory-foundation.mjs",
    "test:foundation": "npm run test:catalog && npm run test:customers && npm run test:inventory",
    "test:live-intake": "node scripts/test-live-intake.mjs",
    "test:live-commerce": "node scripts/test-live-commerce.mjs",
    "test:live-verification": "node scripts/test-live-verification.mjs",
    "test:live": "npm run test:live-intake && npm run test:live-commerce && npm run test:live-verification && npm run test:live-operations && npm run test:tiktok-channels && npm run test:tiktok-lifecycle && npm run test:live-runtime && npm run test:live-simulator && npm run test:live-provider",
    "test:live-runtime": "node scripts/test-live-runtime.mjs",
    "test:live-simulator": "node scripts/live/test-simulator-pipeline.mjs",
    "test:live-provider": "node --test scripts/live/test-tiktok-connection.test.mjs",
    "diagnose:tiktok": "node scripts/live/test-tiktok-connection.mjs",
    "test:live-operations": "node scripts/test-live-operations.mjs",
    "test:tiktok-channels": "node scripts/test-tiktok-channels.mjs",
    "test:tiktok-lifecycle": "node scripts/test-tiktok-lifecycle.mjs",
    "test:live-concurrency": "node scripts/test-live-concurrency.mjs",
    "test:live-services": "npm --prefix services/live-bridge test",
    "test:concurrency": "node scripts/test-foundation-concurrency.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.js *.json index.html",
    "format:check": "prettier --check src tests scripts/*.mjs *.js *.json index.html",
    "test:builds": "node scripts/verify-builds.mjs",
    "test:operations": "node scripts/test-operations.mjs",
    "test:cloud-ui": "playwright test --config playwright.cloud.config.js",
    "check:cloud": "node scripts/check-cloud.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "3.9.6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
